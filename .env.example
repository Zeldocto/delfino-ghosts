# Public client configuration only. Every VITE_ value is inlined into the
# built JavaScript and readable by anyone. Never put a secret key here
# (no service_role key, no S3/R2 access key or secret).

# Supabase -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public base URL of the ghost file bucket (R2 custom domain or r2.dev URL), no trailing slash
VITE_GHOSTS_PUBLIC_BASE_URL=https://ghosts.example.org
